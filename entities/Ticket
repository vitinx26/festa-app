{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "party_id": {
      "type": "string",
      "description": "ID da festa"
    },
    "party_name": {
      "type": "string",
      "description": "Nome da festa (cache)"
    },
    "party_date": {
      "type": "string",
      "format": "date",
      "description": "Data da festa"
    },
    "party_theme": {
      "type": "string",
      "description": "Tema da festa"
    },
    "buyer_email": {
      "type": "string",
      "description": "E-mail do comprador"
    },
    "buyer_name": {
      "type": "string",
      "description": "Nome do comprador"
    },
    "quantity": {
      "type": "number",
      "description": "Quantidade de ingressos",
      "default": 1
    },
    "price_per_ticket": {
      "type": "number",
      "description": "Pre\u00e7o por ingresso"
    },
    "total_amount": {
      "type": "number",
      "description": "Valor total pago"
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmado",
        "pendente",
        "cancelado"
      ],
      "default": "pendente",
      "description": "Status do ingresso"
    },
    "ticket_code": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico do ingresso"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "party_name",
    "buyer_email",
    "buyer_name",
    "quantity",
    "price_per_ticket"
  ]
}