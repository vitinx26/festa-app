{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "phone": {
      "type": "string",
      "description": "Telefone do cliente"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Se o cliente est\u00e1 ativo"
    }
  },
  "required": [
    "name"
  ],
